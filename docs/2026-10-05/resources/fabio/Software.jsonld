        "@value": "\n        :my-software a fabio:Software ;\n            dcterms:title 'Data Parser Tool'@en ;\n            dcterms:creator :john-doe ;\n            dcterms:description 'A set of instructions that a computer can use to perform a specific task.'@en .\n            "
