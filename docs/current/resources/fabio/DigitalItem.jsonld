      {
        "@language": "en",
        "@value": "digital item"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "_:na015ac9d06cd4cb1a3cee73cd225cdebb107"
