@prefix frbr: <http://purl.org/vocab/frbr/core#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prism: <http://prismstandard.org/namespaces/basic/2.0/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix reg: <http://purl.org/linked-data/registry#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix vs: <http://www.w3.org/2003/06/sw-vocab-status/ns#> .

prism:keyword a owl:DatatypeProperty ;
    rdfs:label "has keyword"@en ;
    vann:example """
        :my-research-paper a fabio:ResearchPaper ;
            prism:keyword
                'legal ontologies' ,
                'methodology' ,
                'ontology modeling' ,
                'professional knowledge' ,
                'rhetorical structure theory' .
    """ ;
    rdfs:comment "A keyword associated with a resource, that is likely to be used in search queries."@en ;
    rdfs:domain frbr:Endeavour ;
    rdfs:isDefinedBy prism: ;
    rdfs:subPropertyOf owl:topDataProperty ;
    vs:term_status reg:statusStable .

